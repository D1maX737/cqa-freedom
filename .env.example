# Адрес API организаторов целиком, включая подпись. group_id добавляет код.
DATASET_URL=

# mock — детерминированные ответы без сети; anthropic — настоящая оценка.
LLM_PROVIDER=mock

# Нужны только для LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# Сколько диалогов оценивать одновременно.
LLM_CONCURRENCY=4

# Необязательные настройки.
PORT=3000
HOST=127.0.0.1
UI_LANGUAGE=RU
