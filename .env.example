# Адрес API организаторов целиком, включая подпись. group_id добавляет код.
DATASET_URL=

# mock — детерминированные ответы без сети; gemini или anthropic — настоящая оценка.
LLM_PROVIDER=mock

# Нужны только для LLM_PROVIDER=gemini. Ключ бесплатно выдаёт https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Запросов в минуту: лимит модели на бесплатном тарифе указан в AI Studio, раздел Rate limits.
GEMINI_RPM=14
# Необязательно: уровень рассуждений, например minimal или high. Пусто — по умолчанию модели.
GEMINI_THINKING=

# Нужны только для LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# Сколько диалогов оценивать одновременно.
LLM_CONCURRENCY=4

# Название команды для results/*/results.json (npm run export).
TEAM_NAME=

# Необязательные настройки.
PORT=3000
HOST=127.0.0.1
UI_LANGUAGE=RU
