# Адрес API организаторов целиком, включая подпись. group_id добавляет код.
DATASET_URL=

# mock — детерминированные ответы без сети; gemini или anthropic — настоящая оценка.
LLM_PROVIDER=mock

# Нужны только для LLM_PROVIDER=gemini. Ключ бесплатно выдаёт https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Запросов в минуту: лимит модели на бесплатном тарифе указан в AI Studio, раздел Rate limits.
GEMINI_RPM=14
# Уровень рассуждений: high заметно точнее ловит ошибки ведения диалога. Пусто — по умолчанию модели.
# Модели 2.5 этот параметр не принимают: для них оставьте пустым.
GEMINI_THINKING=high
# Сколько секунд ждать ответа, потом повтор. Медленным моделям вроде Gemma нужно 300.
GEMINI_TIMEOUT_SEC=90

# Нужны только для LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# Решения проверяющего по апелляциям попадают в промпт как прецеденты для других диалогов. 0 — выключить.
PRECEDENTS=1

# Перепроверка рискованных ответов («Нет», N/A, неполная шкала, грубая ошибка) вторым запросом. 1 — включить.
# Удваивает часть запросов; включайте, если на размеченном DEV это повышает точность (npm run accuracy).
RECHECK=0

# Сколько диалогов оценивать одновременно.
LLM_CONCURRENCY=4

# Название команды для results/*/results.json (npm run export).
TEAM_NAME=

# Необязательные настройки.
PORT=3000
HOST=127.0.0.1
UI_LANGUAGE=RU
